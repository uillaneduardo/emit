# Application
NODE_ENV=production
APP_NAME=emit
APP_PORT=3000
API_PORT=3001
APP_URL=https://checklist.example.com
API_URL=https://checklist.example.com/api

# PostgreSQL
POSTGRES_DB=emit
POSTGRES_USER=emit
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://emit:change-me@postgres:5432/emit?schema=public

# MinIO / S3
MINIO_ROOT_USER=emit
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=emit
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=emit
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

# Authentication
AUTH_SECRET=change-me-to-a-long-random-secret

# Optional Redis
REDIS_URL=redis://redis:6379

# Public access
PUBLIC_BASE_URL=https://checklist.example.com/public

# Reverse proxy
TRUST_PROXY=true
